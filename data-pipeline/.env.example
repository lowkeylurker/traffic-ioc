# --- API Keys ---
TOMTOM_API_KEY=
TOMTOM_API_KEYS=
TOMTOM_DAILY_LIMIT_PER_KEY=2500
SERPAPI_KEY=
OPENWEATHER_API_KEY=

# --- ETL Schedule ---
# 06:00-21:00 every 15 minutes (inclusive 21:00) = 61 cycles/day
ETL_WINDOW_START_HOUR=6
ETL_WINDOW_END_HOUR=21
ETL_ACTIVE_CYCLES_PER_DAY=61
CYCLE_INTERVAL_MINUTES=15
RETRY_SLEEP_MINUTES=5
SEGMENT_LIMIT=1200
TARGET_CORRIDOR_MIN_COVERAGE_PCT=0.60
GOLD_CORRIDOR_NAMES=

# --- OpenWeather Grid Mode (Option C) ---
OWM_GRID_SIZE_M=500
OWM_GRID_MIN_CALL_INTERVAL_SEC=0.9

# --- Postgres DB (required) ---
# Example (Azure PostgreSQL):
# DATABASE_URL=postgresql://traffic_admin:password@psql-smart-traffic-dev.postgres.database.azure.com:5432/traffic_ioc_db?sslmode=require
DATABASE_URL=

# --- Azure DB (optional explicit vars) ---
DB_HOST_AZURE=
DB_USER_AZURE=
DB_PORT_AZURE=5432
DB_NAME_AZURE=
DB_PASSWORD_AZURE=

# --- PCU Estimation (BPR inverse tuning) ---
PCU_BPR_ALPHA=0.35
PCU_BPR_BETA=4.0
PCU_MAX_VC_RATIO=1.0

# --- Cloudinary (optional) ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Logging (optional) ───────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
