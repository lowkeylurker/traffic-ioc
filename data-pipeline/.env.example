# --- API Keys ---
TOMTOM_API_KEY=
SERPAPI_KEY=
OPENWEATHER_API_KEY=

# --- ETL Schedule ---
# 06:00-21:00 every 15 minutes (inclusive 21:00) = 61 cycles/day
ETL_WINDOW_START_HOUR=6
ETL_WINDOW_END_HOUR=21
ETL_ACTIVE_CYCLES_PER_DAY=61

# --- OpenWeather Grid Mode (Option C) ---
OWM_GRID_SIZE_M=500
OWM_GRID_MIN_CALL_INTERVAL_SEC=0.9

# --- PCU Estimation (BPR inverse tuning) ---
PCU_BPR_ALPHA=0.35
PCU_BPR_BETA=4.0
PCU_MAX_VC_RATIO=1.0

# --- Postgres DB ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASSWORD=
DB_USER=
DB_SSLMODE=

# ── Logging (tuỳ chọn) ───────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_DIR=                            