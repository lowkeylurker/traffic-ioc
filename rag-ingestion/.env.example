# ==============================================================================
# Vietnam Traffic Legislation RAG Ingestion Microservice (.env.example)
# ==============================================================================

# Server Environment & Network Binding
APP_NAME="Vietnam Traffic Legislation Ingestion Service"
APP_ENV=development
HOST=0.0.0.0
PORT=8001

# PostgreSQL OLTP Database Connection (Asyncpg for KnowledgeBase & Chunks)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://traffic_user:traffic_password@localhost:5434/traffic_ioc_oltp

# MinIO / S3 Object Storage (Document binary storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=traffic-ioc-documents
MINIO_SECURE=false

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vietnam_traffic_laws
QDRANT_VECTOR_SIZE=1024

# Ollama Dense Embeddings (BAAI/bge-m3 1024-dim)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# Redis Pub/Sub (Asynchronous Ingestion Event Broadcasting)
REDIS_URL=redis://localhost:6379
REDIS_INGESTION_CHANNEL=rag:ingestion:events

# Google Gemini Vision OCR (for scanned PDF & decree image transcription)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_OCR_MODEL=gemini-1.5-flash
