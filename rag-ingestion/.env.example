# ==============================================================================
# Vietnam Traffic Legislation RAG Ingestion Microservice (.env.example)
# ==============================================================================

APP_NAME="Vietnam Traffic Legislation Ingestion Service"
APP_ENV=development
HOST=0.0.0.0
PORT=8001

# PostgreSQL OLTP Database Connection (Knowledge tables)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traffic_oltp_db

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vietnam_traffic_laws
QDRANT_VECTOR_SIZE=1024

# Ollama Local Embeddings (BGE-M3 1024-dim)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# Google Gemini Vision OCR (for scanned PDF extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_OCR_MODEL=gemini-1.5-flash
