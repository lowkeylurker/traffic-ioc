# ════════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE & MONOREPO ENVIRONMENT - Smart Traffic IOC
# ════════════════════════════════════════════════════════════════════════════════

PROJECT_NAME="Smart Traffic IOC - TP.HCM"
PROJECT_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true

# ════════════════════════════════════════════════════════════════════════════════
# DATABASES (PostgreSQL + PostGIS)
# ════════════════════════════════════════════════════════════════════════════════
DB_HOST=postgres
DB_PORT=5432
DB_USER=traffic_user
DB_PASSWORD=traffic_password
DB_SCHEMA=public
DB_SSLMODE=disable

# 1. Data Warehouse / Analytics Database (Facts, Dimensions, PostGIS)
DW_DB_NAME=traffic_dw_db
DW_DATABASE_URL=postgresql://traffic_user:traffic_password@localhost:5432/traffic_dw_db?schema=public

# 2. OLTP App Database (RAG metadata, Chat sessions, Feedback, User Incidents)
OLTP_DB_NAME=traffic_oltp_db
OLTP_DATABASE_URL=postgresql://traffic_user:traffic_password@localhost:5432/traffic_oltp_db?schema=public

# Legacy fallback
DATABASE_URL=postgresql://traffic_user:traffic_password@localhost:5432/traffic_dw_db?schema=public

# ════════════════════════════════════════════════════════════════════════════════
# MONGODB (Response Cache & Event Store)
# ════════════════════════════════════════════════════════════════════════════════
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
DATABASE_CACHE_RESPONSE_URL=mongodb://root:example@localhost:27017/traffic-ioc-cache-response-db?authSource=admin

# ════════════════════════════════════════════════════════════════════════════════
# REDIS (Caching & BullMQ Background Queues)
# ════════════════════════════════════════════════════════════════════════════════
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ════════════════════════════════════════════════════════════════════════════════
# QDRANT (Vector Search Engine for RAG)
# ════════════════════════════════════════════════════════════════════════════════
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietnam_traffic_laws

# ════════════════════════════════════════════════════════════════════════════════
# OLLAMA (Local LLM & Embedding Models)
# ════════════════════════════════════════════════════════════════════════════════
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b
EMBEDDING_MODEL_NAME=bge-m3

# ════════════════════════════════════════════════════════════════════════════════
# THIRD-PARTY INTEGRATIONS & APIS
# ════════════════════════════════════════════════════════════════════════════════
# TomTom (Traffic Tiles & Geocoding)
TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeather API (Weather metrics for pipeline)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API (Legal RAG assistant, Vision OCR, News Ticker)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL_NAME=gemini-1.5-flash

# Mapbox GL Token (Frontend Maps)
MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHl4eHh4eHgifQ.xxxxxxxxxxxx

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (Incident Photos & CSV Exports)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ════════════════════════════════════════════════════════════════════════════════
# BACKEND SERVICE (apps/backend)
# ════════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001
RELIABILITY_QUEUE_ENABLED=true
OLAP_MART_DAILY_ENABLED=true

# ════════════════════════════════════════════════════════════════════════════════
# AI-CORE SERVICE (ai-core)
# ════════════════════════════════════════════════════════════════════════════════
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════════════════════════
# RAG INGESTION SERVICE (rag-ingestion)
# ════════════════════════════════════════════════════════════════════════════════
RAG_INGESTION_PORT=8001

# ════════════════════════════════════════════════════════════════════════════════
# FRONTEND APPS (apps/admin-web & apps/user-web)
# ════════════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
