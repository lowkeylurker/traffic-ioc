# ════════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE ENVIRONMENT - Smart Traffic IOC
# ════════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL + PostGIS)
# For local Docker: use "postgres" as DB_HOST, defaults shown below
# For Azure: use your Azure PostgreSQL server details
# ════════════════════════════════════════════════════════════════════════════════
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=disable

# Azure Database Example (uncomment and fill in for Azure deployment):
# DB_HOST=<your-azure-postgres-host>
# DB_USER=traffic_admin@psql-smart-traffic-dev
# DB_PASSWORD=<your-azure-password>
# DB_SSLMODE=require

# ════════════════════════════════════════════════════════════════════════════════
# REDIS (Optional for caching)
# ════════════════════════════════════════════════════════════════════════════════
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ════════════════════════════════════════════════════════════════════════════════
# DATA-PIPELINE SERVICE
# ════════════════════════════════════════════════════════════════════════════════
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=

# ════════════════════════════════════════════════════════════════════════════════
# AI-CORE SERVICE (Traffic Forecasting, Congestion Prediction, Data Imputation)
# ════════════════════════════════════════════════════════════════════════════════
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_LOG_LEVEL=INFO

# Model Paths
MODEL_PATH=./models
FORECAST_MODEL_PATH=./models/traffic_forecast/lstm_model.pkl
RL_CONGESTION_MODEL_PATH=./models/congestion_rl/dqn_agent.pt
CLUSTERING_MODEL_PATH=./models/clustering/kmeans_model.pkl
SCALER_PATH=./models/clustering/scaler.pkl

# Forecast Configuration
FORECAST_HORIZON=15
FORECAST_HISTORY_WINDOW=480
FORECAST_ENSEMBLE_ENABLED=true

# Reinforcement Learning Configuration
RL_ALGORITHM=dqn
RL_CONGESTION_THRESHOLD=0.6
RL_HISTORY_WINDOW=180
RL_PREDICTION_HORIZON=15
RL_EPSILON=0.1

# Clustering & Imputation Configuration
CLUSTERING_ALGORITHM=kmeans
CLUSTERING_N_CLUSTERS=8
CLUSTERING_DBSCAN_EPS=0.5
CLUSTERING_DBSCAN_MIN_SAMPLES=5
CLUSTERING_FEATURES=geometry,avg_speed,peak_hour_ratio
IMPUTATION_METHOD=knn
IMPUTATION_K_NEIGHBORS=5

# ════════════════════════════════════════════════════════════════════════════════
# BACKEND SERVICE (Node.js/TypeScript)
# ════════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
BACKEND_PORT=3000
BACKEND_LOG_LEVEL=debug

# JWT Secret (required in production)
JWT_SECRET=

# ════════════════════════════════════════════════════════════════════════════════
# FRONTEND SERVICE (Vue.js/React/etc.)
# ════════════════════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:3000/api
VITE_MAPBOX_TOKEN=

# ════════════════════════════════════════════════════════════════════════════════
# PROJECT INFO
# ════════════════════════════════════════════════════════════════════════════════
PROJECT_NAME=Smart Traffic IOC - TP.HCM
PROJECT_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
