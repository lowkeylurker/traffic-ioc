# Giúp Editor xác định đây là file cấu hình gốc của dự án
root = true

# Cấu hình chung cho TẤT CẢ các file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 1. Cấu hình riêng cho Node.js (JavaScript / JSON)
# Node.js thường ưu tiên dùng 2 khoảng trắng (2 spaces) để code gọn hơn
[*.{js,cjs,mjs,json}]
indent_style = space
indent_size = 2

# 2. Cấu hình riêng cho Python
# Python cực kỳ nghiêm ngặt về thụt lề.
# Theo chuẩn PEP 8, Python BẮT BUỘC dùng 4 khoảng trắng.
[*.py]
indent_style = space
indent_size = 4

# 3. Cấu hình cho file Markdown (Ví dụ file README.md)
[*.md]
trim_trailing_whitespace = false
