{
  "name": "traffic-ioc-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=@traffic-ioc/admin-web",
    "dev:user": "turbo dev --filter=@traffic-ioc/user-web",
    "dev:backend": "turbo dev --filter=@traffic-ioc/backend",
    "build": "turbo build",
    "build:check": "turbo build:check",
    "lint": "turbo lint",
    "prisma:gen": "turbo prisma:gen",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/.next packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.4.4",
    "typescript": "^5.3.3"
  }
}
