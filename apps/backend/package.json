{
  "name": "@traffic-ioc/backend",
  "version": "1.0.0",
  "description": "Smart Traffic IOC - Backend API (Prisma)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --ignore dist --exec ts-node src/server.ts",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prisma:gen": "npx prisma generate --schema=prisma/oltp.prisma && npx prisma generate --schema=prisma/dw.prisma",
    "prisma:gen:oltp": "npx prisma generate --schema=prisma/oltp.prisma",
    "prisma:gen:dw": "npx prisma generate --schema=prisma/dw.prisma",
    "prisma:migrate:oltp": "npx prisma migrate dev --schema=prisma/oltp.prisma",
    "prisma:deploy:oltp": "npx prisma migrate deploy --schema=prisma/oltp.prisma",
    "prisma:status:oltp": "npx prisma migrate status --schema=prisma/oltp.prisma",
    "prisma:push:oltp": "npx prisma db push --schema=prisma/oltp.prisma",
    "prisma:pull:dw": "npx prisma db pull --schema=prisma/dw.prisma",
    "prisma:pull": "npx prisma db pull --schema=prisma/dw.prisma",
    "script:backfill-corridor-cache": "ts-node src/scripts/backfill-corridor-cache.ts",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "traffic",
    "gis",
    "api",
    "prisma"
  ],
  "author": "Smart Traffic Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@azure/storage-blob": "^12.31.0",
    "@clerk/express": "^1.7.68",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.7.1",
    "@qdrant/js-client-rest": "^1.12.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@traffic-ioc/shared": "workspace:*",
    "@types/pg": "^8.18.0",
    "ai": "^4.1.0",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-csv": "^5.0.2",
    "geojson": "^0.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.1",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^8.0.7",
    "ollama-ai-provider": "^1.1.0",
    "pg": "^8.20.0",
    "pg-query-stream": "^4.7.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@traffic-ioc/shared-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.16",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
