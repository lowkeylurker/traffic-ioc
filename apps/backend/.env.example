# ==============================================================================
# Smart Traffic IOC - Backend Service Configuration (.env.example)
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated origins or wildcard '*')
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ==============================================================================
# Databases (PostgreSQL / Prisma)
# ==============================================================================
# 1. OLTP App Database (RAG metadata, Chat sessions, Feedback, Citizen Incidents)
OLTP_DATABASE_URL="postgresql://traffic_user:traffic_password@localhost:5432/traffic_oltp_db?schema=public"

# 2. Data Warehouse / OLAP Analytics Database (Fact/Dim tables, PostGIS)
DW_DATABASE_URL="postgresql://traffic_user:traffic_password@localhost:5432/traffic_dw_db?schema=public"

# Fallback alias for backward-compatibility
DATABASE_URL="postgresql://traffic_user:traffic_password@localhost:5432/traffic_dw_db?schema=public"

# Database Connection Pool Tuning
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=20
PG_POOL_MAX=10

# ==============================================================================
# MongoDB (API Response Cache & Realtime Notifications)
# ==============================================================================
DATABASE_CACHE_RESPONSE_URL="mongodb://root:example@localhost:27017/traffic-ioc-cache-response-db?authSource=admin"

# ==============================================================================
# Redis & BullMQ Asynchronous Queues
# ==============================================================================
REDIS_URL=redis://localhost:6379

# Reliability Mart & Batch Jobs
RELIABILITY_QUEUE_ENABLED=true
RELIABILITY_JOB_CONCURRENCY=1
RELIABILITY_JOB_ATTEMPTS=3
RELIABILITY_JOB_BACKOFF_MS=5000
RELIABILITY_SPATIAL_FALLBACK=false
RELIABILITY_DAILY_ENABLED=true
RELIABILITY_SCHEDULE_SOURCE_PERIOD=WEEKLY
RELIABILITY_DAILY_CRON="0 2 * * *"

# OLAP Summary Mart Cron Job
OLAP_MART_DAILY_ENABLED=true
OLAP_MART_DAILY_CRON="0 2 * * *"

# ==============================================================================
# Authentication & Authorization (Clerk)
# ==============================================================================
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BYPASS_AUTH_FOR_BENCHMARK=false

# ==============================================================================
# Cloudinary (Incident Photos & CSV Export Reports)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
CLOUDINARY_INCIDENT_FOLDER=traffic-ioc/incidents
CLOUDINARY_CSV_FOLDER=traffic-ioc/csv-reports

# ==============================================================================
# External Mapping & Geocoding APIs
# ==============================================================================
TOMTOM_API_KEY=your_tomtom_api_key_here

# ==============================================================================
# RAG, LLM Gateway & Vector Search
# ==============================================================================
# Provider: 'google' or 'ollama'
LLM_PROVIDER=google

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL_NAME=gemini-1.5-flash

# Ollama Local LLM & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b
EMBEDDING_MODEL_NAME=bge-m3

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietnam_traffic_laws

# ==============================================================================
# Azure Blob Storage (Optional CSV report exports)
# ==============================================================================
AZURE_STORAGE_CONNECTION_STRING=

# ==============================================================================
# Email & SMTP Notifications (Nodemailer)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=no-reply@traffic-ioc.vn

# ==============================================================================
# Observability & Monitoring (Sentry)
# ==============================================================================
SENTRY_DSN=
