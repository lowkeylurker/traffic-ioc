PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/traffic_ioc_db?schema=public"
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
CLOUDINARY_INCIDENT_FOLDER=traffic-ioc/incidents

# Redis + Reliability batch orchestration
REDIS_URL=redis://localhost:6379
RELIABILITY_QUEUE_ENABLED=true
RELIABILITY_JOB_CONCURRENCY=1
RELIABILITY_JOB_ATTEMPTS=3
RELIABILITY_JOB_BACKOFF_MS=5000
RELIABILITY_SPATIAL_FALLBACK=false

# MongoDB (Response Cache)
DATABASE_CACHE_RESPONSE_URL=mongodb://root:example@localhost:27017/traffic-ioc-cache-response-db?authSource=admin

# Docker Compose Variables (Optional overrides)
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=traffic_password
POSTGRES_DB=traffic_backend_db
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# Google Gemini (Used for News Ticker)
GEMINI_API_KEY=your_gemini_api_key_here

