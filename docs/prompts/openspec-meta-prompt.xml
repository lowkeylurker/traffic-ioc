export const WeatherWidget: React.FC<WeatherWidgetProps> = ({
  style,
  compact = false,
  weatherData,
  loading: externalLoading,
  error: externalError,
}) => {
  const data = weatherData ?? MOCK_WEATHER
  const loading = externalLoading ?? false
  const error = externalError ?? null

