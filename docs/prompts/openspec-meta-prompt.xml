        id: 'reliability-corridor-selected-outline-layer',
        type: 'line',
        filter: ['==', ['get', 'isSelected'], 1],
        paint: {
          'line-color': '#ffffff',
          'line-width': 8 + selectedPulseFactor * 4,
          'line-opacity': 0.65 + selectedPulseFactor * 0.3,
        },
