          </Row>
          <Row gutter={[16, 16]} style={{ marginBottom: 16 }}>
            <Col xs={24} lg={14}>
              <Card title="Đang tải dữ liệu tốc độ...">
                <Skeleton active paragraph={{ rows: 8 }} />
              </Card>
            </Col>
            <Col xs={24} lg={10}>
              <Card title="Đang tải dữ liệu TTI...">
                <Skeleton active paragraph={{ rows: 8 }} />
              </Card>
