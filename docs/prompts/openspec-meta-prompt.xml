                      <span
                        style={{ fontSize: 11, color: 'rgba(0, 0, 0, 0.45)' }}
                      >
                        {formatRelativeTime(alert.timestamp)}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            )}
          />
        )}
      </div>
    </div>
  )
}
