      res.status(400).json({ error: 'Tham số lat/lng không hợp lệ' });
      return;
    }

    const result = await trafficTileService.getSegmentDetail(lat, lng);

    if ('error' in result) {
      res.status(result.status).json({ error: result.error });
      return;
    }

    res.json(result);
