        filter: ['==', ['get', 'isSelected'], 1],
        paint: {
          'line-color': ['coalesce', ['get', 'lineColor'], '#cf1322'],
          'line-width': 5 + selectedPulseFactor * 3,
          'line-opacity': 0.8 + selectedPulseFactor * 0.2,
