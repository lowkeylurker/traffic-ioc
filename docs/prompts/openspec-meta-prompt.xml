  )

  const tomTomIncidentPointLayerStyle = useMemo(
    () =>
      ({
        id: 'tomtom-incident-point-layer',
        type: 'symbol',
        source: 'tomtom-incident-source',
        'source-layer': 'Traffic incident POI',
        layout: {
