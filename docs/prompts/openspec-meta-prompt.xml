                      </div>
                    ) : (
                      <div style={{ height: '100%', minHeight: 220 }}>
                        <Bar
                          data={topSlowBar.data}
                          options={topSlowBar.options}
                        />
                      </div>
                    )}
                  </Card>
                </Col>

                <Col xs={24} md={12} style={{ height: '100%' }}>
                  <Card
                    size="small"
                    style={{ borderRadius: 12, height: '100%' }}
                    title={
                      <Space size={10}>
                        <AlertOutlined />
                        <span style={{ fontWeight: 700 }}>
                          Điểm nóng (LOS E/F)
                        </span>
                      </Space>
                    }
                    extra={
                      <Tooltip title="Click để zoom vào bản đồ.">
                        <Tag
                          color="default"
                          style={{ margin: 0, cursor: 'help' }}
                        >
                          Tương tác
                        </Tag>
                      </Tooltip>
                    }
                    bodyStyle={{
                      height: 'calc(100% - 48px)',
                      overflow: 'auto',
                    }}
                  >
                    {derived.jamSegments.length === 0 ? (
                      <div style={{ padding: 12, color: 'rgba(0,0,0,0.45)' }}>
                        Chưa ghi nhận đoạn LOS E/F.
                      </div>
                    ) : (
                      <List
                        size="small"
                        dataSource={[...derived.jamSegments]
                          .sort((a, b) => {
                            const sa = a.avgSpeed ?? a.currentSpeed ?? 999
                            const sb = b.avgSpeed ?? b.currentSpeed ?? 999
                            return sa - sb
                          })
                          .slice(0, 10)}
                        renderItem={(stat: TrafficStatus) => {
                          const los = String(
                            stat.losGrade ?? 'N/A'
                          ).toUpperCase()
                          const losColor =
                            los === 'F'
                              ? TRAFFIC_COLORS.EXTREME
                              : los === 'E'
                                ? TRAFFIC_COLORS.VERY_HIGH
                                : 'rgba(0,0,0,0.25)'

                          return (
                            <List.Item
                              key={stat.segmentId}
                              style={{
                                cursor: 'pointer',
                                paddingLeft: 6,
                                paddingRight: 6,
                              }}
                              onClick={() => handleSegmentClick(stat)}
                            >
                              <List.Item.Meta
                                title={
                                  <div
                                    style={{
                                      display: 'flex',
                                      justifyContent: 'space-between',
                                      gap: 10,
                                    }}
                                  >
                                    <span
                                      style={{
                                        fontWeight: 600,
                                        fontSize: 12,
                                        lineHeight: 1.2,
                                      }}
                                    >
                                      {stat.segmentName}
                                    </span>
                                    <Tag
                                      color={los === 'F' ? 'red' : 'volcano'}
                                      style={{ margin: 0 }}
                                    >
                                      LOS {los}
                                    </Tag>
                                  </div>
                                }
                                description={
                                  <div
                                    style={{
                                      display: 'flex',
                                      justifyContent: 'space-between',
                                      gap: 10,
                                      fontSize: 11,
                                      color: 'rgba(0,0,0,0.45)',
                                    }}
                                  >
                                    <span>
                                      Vận tốc:{' '}
                                      {Number(
                                        stat.avgSpeed ?? stat.currentSpeed ?? 0
                                      ).toFixed(1)}{' '}
                                      km/h
                                    </span>
                                    <span
                                      style={{
                                        color: losColor,
                                        fontWeight: 700,
                                      }}
                                    >
                                      {los === 'F'
                                        ? 'Nguy cơ tê liệt'
                                        : 'Cần theo dõi'}
                                    </span>
                                  </div>
                                }
                              />
                            </List.Item>
                          )
                        }}
                      />
                    )}
                  </Card>
                </Col>
              </Row>
            </Col>
          </Row>
        </div>
      </div>
    </div>
  )
}
