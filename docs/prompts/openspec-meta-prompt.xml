                allowClear={false}
              />
            </Space>
          </Col>
          <Col xs={24} lg={10}>
            <div style={{ textAlign: 'right' }}>
              <Tag
                icon={
                  opStatus.level === 'success' ? (
                    <CheckCircleOutlined />
