  const tomTomIncidentPointFallbackLayerStyle = useMemo(
    () =>
      ({
        id: 'tomtom-incident-point-fallback-layer',
        type: 'circle',
        source: 'tomtom-incident-source',
        'source-layer': 'Traffic incident POI',
        paint: {
          'circle-color': '#dc2626',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 1,
