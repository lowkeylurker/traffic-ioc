                optionType="button"
                buttonStyle="solid"
                size="small"
              >
                <Radio.Button value="WEEKLY">7 ngày gần nhất</Radio.Button>
                <Radio.Button value="MONTHLY">30 ngày gần nhất</Radio.Button>
              </Radio.Group>
            </div>
