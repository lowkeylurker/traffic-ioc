            <Form.Item
              style={{ flex: 1 }}
              name="lat"
              label="Vi do"
              rules={[{ required: true, message: 'Vui lòng nhập vi do' }]}
            >
              <Input size="large" />
            </Form.Item>
            <Form.Item
              style={{ flex: 1 }}
              name="long"
              label="Kinh do"
              rules={[{ required: true, message: 'Vui lòng nhập kinh do' }]}
            >
              <Input size="large" />
