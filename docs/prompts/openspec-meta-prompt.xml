  height: 100% !important;
  display: flex;
  flex-direction: column;
}
  ant-table-body {
  flex: 1;
  overflow-y: auto !important;
  max-height: 100% !important;
  height: 100%;
}
        `}
      </style>

      <div
        style={{
          width: '100%',
          height: 'calc(100% - 16px)',
