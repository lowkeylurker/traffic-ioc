generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

model bridge_corridor_segment {
  corridor_key   BigInt
  segment_key    BigInt
  sequence_order Int
  dim_corridor   dim_corridor @relation(fields: [corridor_key], references: [corridor_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment    dim_segment  @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)

  @@id([corridor_key, segment_key])
  @@index([segment_key], map: "idx_bridge_corridor_seg_segment")
}

model bridge_date_holiday {
  date_key    Int
  holiday_key Int
  dim_date    dim_date    @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_holiday dim_holiday @relation(fields: [holiday_key], references: [holiday_key], onDelete: NoAction, onUpdate: NoAction)

  @@id([date_key, holiday_key])
}

model dim_corridor {
  corridor_key              BigInt                      @id
  corridor_name             String                      @db.VarChar(255)
  importance_level          Int?                        @db.SmallInt
  target_avg_speed          Decimal?                    @db.Decimal(5, 2)
  total_length_m            Decimal?                    @db.Decimal(12, 2)
  direction                 String?                     @db.VarChar(10)
  record_timestamp          DateTime?                   @default(now()) @db.Timestamp(6)
  corridor_version          Int                         @default(1)
  seed_signature            String?                     @db.VarChar(64)
  bridge_corridor_segment   bridge_corridor_segment[]
  fact_corridor_performance fact_corridor_performance[]
  report_reliability        report_reliability[]
}

model dim_date {
  date_key                     Int                            @id
  month_year_key               Int?
  full_date                    DateTime                       @db.Date
  day_of_week                  Int                            @db.SmallInt
  day_name_vi                  String?                        @db.VarChar(20)
  iso_week                     Int?                           @db.SmallInt
  is_weekend                   Boolean?                       @default(false)
  is_holiday                   Boolean?                       @default(false)
  is_end_of_month              Boolean?                       @default(false)
  bridge_date_holiday          bridge_date_holiday[]
  dim_month_year               dim_month_year?                @relation(fields: [month_year_key], references: [month_year_key], onDelete: NoAction, onUpdate: NoAction)
  fact_citizen_report          fact_citizen_report[]
  fact_corridor_performance    fact_corridor_performance[]
  fact_event                   fact_event[]
  fact_incident                fact_incident[]
  fact_simulation_scenario     fact_simulation_scenario[]
  fact_traffic_flow            fact_traffic_flow[]
  fact_traffic_risk_prediction fact_traffic_risk_prediction[]

  @@index([month_year_key], map: "idx_dim_date_month_year")
}

model dim_holiday {
  holiday_key         Int                   @id
  holiday_name_vi     String?               @db.VarChar(255)
  duration_days       Int?                  @db.SmallInt
  is_public_holiday   Boolean?              @default(false)
  record_timestamp    DateTime?             @default(now()) @db.Timestamp(6)
  bridge_date_holiday bridge_date_holiday[]
}

model dim_location {
  location_key        BigInt                   @id
  ward                String?                  @db.VarChar(100)
  district            String?                  @db.VarChar(100)
  city                String?                  @default("Hồ Chí Minh") @db.VarChar(100)
  geometry_polygon    Unsupported("geometry")?
  record_timestamp    DateTime?                @default(now()) @db.Timestamp(6)
  dim_segment         dim_segment[]
  fact_citizen_report fact_citizen_report[]
  fact_event          fact_event[]
  fact_incident       fact_incident[]
}

model dim_month_year {
  month_year_key   Int        @id
  month_number     Int        @db.SmallInt
  month_name_vi    String?    @db.VarChar(50)
  month_start_date DateTime?  @db.Date
  month_end_date   DateTime?  @db.Date
  days_in_month    Int?       @db.SmallInt
  quarter_number   Int        @db.SmallInt
  quarter_name     String?    @db.VarChar(50)
  year             Int        @db.SmallInt
  days_in_year     Int?       @db.SmallInt
  is_leap_year     Boolean?
  dim_date         dim_date[]
}

model dim_node {
  node_key                                        BigInt                   @id
  node_source_id                                  BigInt?
  is_snapped                                      Boolean?                 @default(false)
  node_type                                       String?                  @db.VarChar(30)
  geometry                                        Unsupported("geometry")?
  record_timestamp                                DateTime?                @default(now()) @db.Timestamp(6)
  dim_segment_dim_segment_from_node_keyTodim_node dim_segment[]            @relation("dim_segment_from_node_keyTodim_node")
  dim_segment_dim_segment_to_node_keyTodim_node   dim_segment[]            @relation("dim_segment_to_node_keyTodim_node")

  @@index([geometry], map: "idx_dim_node_geom_gist", type: Gist)
}

model dim_road {
  road_key         BigInt    @id
  name             String    @db.VarChar(100)
  total_length_m   Decimal?  @db.Decimal(10, 2)
  record_timestamp DateTime? @default(now()) @db.Timestamp(6)
  dim_way          dim_way[]
}

model dim_segment {
  segment_key                                  BigInt                         @id
  from_node_key                                BigInt?
  to_node_key                                  BigInt?
  way_key                                      BigInt?
  location_key                                 BigInt?
  segment_id_source                            BigInt?
  length_m                                     Decimal?                       @db.Decimal(10, 2)
  geometry_center                              Unsupported("geometry")?
  geometry_linestring                          Unsupported("geometry")?
  is_one_way                                   Boolean?                       @default(false)
  record_timestamp                             DateTime?                      @default(now()) @db.Timestamp(6)
  bridge_corridor_segment                      bridge_corridor_segment[]
  dim_node_dim_segment_from_node_keyTodim_node dim_node?                      @relation("dim_segment_from_node_keyTodim_node", fields: [from_node_key], references: [node_key], onDelete: NoAction, onUpdate: NoAction)
  dim_location                                 dim_location?                  @relation(fields: [location_key], references: [location_key], onDelete: NoAction, onUpdate: NoAction)
  dim_node_dim_segment_to_node_keyTodim_node   dim_node?                      @relation("dim_segment_to_node_keyTodim_node", fields: [to_node_key], references: [node_key], onDelete: NoAction, onUpdate: NoAction)
  dim_way                                      dim_way?                       @relation(fields: [way_key], references: [way_key], onDelete: NoAction, onUpdate: NoAction)
  fact_citizen_report                          fact_citizen_report[]
  fact_corridor_performance                    fact_corridor_performance[]
  fact_incident                                fact_incident[]
  fact_simulation_scenario                     fact_simulation_scenario[]
  fact_traffic_flow                            fact_traffic_flow[]
  fact_traffic_risk_prediction                 fact_traffic_risk_prediction[]
  report_reliability                           report_reliability[]

  @@index([geometry_center], map: "idx_dim_segment_center_gist", type: Gist)
  @@index([from_node_key], map: "idx_dim_segment_from_node")
  @@index([geometry_linestring], map: "idx_dim_segment_linestring_gist", type: Gist)
  @@index([location_key], map: "idx_dim_segment_location")
  @@index([to_node_key], map: "idx_dim_segment_to_node")
  @@index([way_key], map: "idx_dim_segment_way")
}

model report_reliability {
  report_key               BigInt       @id @default(autoincrement())
  corridor_key             BigInt
  segment_key              BigInt
  time_window              String       @db.VarChar(20)
  period_start             DateTime     @db.Timestamp(6)
  period_end               DateTime     @db.Timestamp(6)
  t_avg                    Decimal?     @db.Decimal(12, 4)
  t_95                     Decimal?     @db.Decimal(12, 4)
  t_freeflow               Decimal?     @db.Decimal(12, 4)
  buffer_index             Decimal?     @db.Decimal(12, 6)
  pti                      Decimal?     @db.Decimal(12, 6)
  cause_accident_count     Int          @default(0)
  cause_flood_count        Int          @default(0)
  cause_construction_count Int          @default(0)
  source_period            String       @db.VarChar(20)
  job_run_id               String?      @db.VarChar(120)
  computed_at              DateTime     @default(now()) @db.Timestamp(6)
  quality_flag             Int?         @default(1) @db.SmallInt
  dim_corridor             dim_corridor @relation(fields: [corridor_key], references: [corridor_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment              dim_segment  @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)

  @@unique([corridor_key, segment_key, time_window, period_start, period_end], map: "uq_report_reliability_corridor_segment_window_period")
  @@index([time_window, period_start, period_end], map: "idx_report_reliability_window_period")
  @@index([time_window, period_start, period_end, buffer_index(sort: Desc)], map: "idx_report_reliability_window_buffer")
  @@index([time_window, period_start, period_end, pti(sort: Desc)], map: "idx_report_reliability_window_pti")
  @@index([corridor_key, segment_key, period_start, period_end], map: "idx_report_reliability_corridor_segment_period")
}

model dim_shift {
  shift_key        Int               @id
  shift_code       String?           @db.VarChar(20)
  shift_name_vi    String?           @db.VarChar(50)
  start_hour       Int?              @db.SmallInt
  end_hour         Int?              @db.SmallInt
  is_peak_hour     Boolean?          @default(false)
  record_timestamp DateTime?         @default(now()) @db.Timestamp(6)
  dim_time_of_day  dim_time_of_day[]
}

model dim_time_of_day {
  time_key                                              Int                            @id
  default_shift_key                                     Int?
  hhmm                                                  Int?                           @db.SmallInt
  bucket_5min_key                                       Int?                           @db.SmallInt
  bucket_15min_key                                      Int?                           @db.SmallInt
  bucket_60min_key                                      Int?                           @db.SmallInt
  is_business_hours                                     Boolean?                       @default(false)
  dim_shift                                             dim_shift?                     @relation(fields: [default_shift_key], references: [shift_key], onDelete: NoAction, onUpdate: NoAction)
  fact_citizen_report                                   fact_citizen_report[]
  fact_corridor_performance                             fact_corridor_performance[]
  fact_event_fact_event_end_time_keyTodim_time_of_day   fact_event[]                   @relation("fact_event_end_time_keyTodim_time_of_day")
  fact_event_fact_event_start_time_keyTodim_time_of_day fact_event[]                   @relation("fact_event_start_time_keyTodim_time_of_day")
  fact_incident                                         fact_incident[]
  fact_simulation_scenario                              fact_simulation_scenario[]
  fact_traffic_flow                                     fact_traffic_flow[]
  fact_traffic_risk_prediction                          fact_traffic_risk_prediction[]

  @@index([default_shift_key], map: "idx_dim_time_shift")
}

model dim_way {
  way_key             BigInt        @id
  road_key            BigInt?
  total_length_m      Decimal?      @db.Decimal(10, 2)
  direction           String?       @db.VarChar(20)
  segment_count       Int?
  default_lane_count  Int?          @db.SmallInt
  design_capacity     Int?
  default_speed_limit Int?          @db.SmallInt
  tomtom_frc          Int?          @db.SmallInt
  osm_highway_type    String?       @db.VarChar(30)
  record_timestamp    DateTime?     @default(now()) @db.Timestamp(6)
  dim_segment         dim_segment[]
  dim_road            dim_road?     @relation(fields: [road_key], references: [road_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([road_key], map: "idx_dim_way_road")
}

model dim_weather {
  weather_key       Int                 @id
  weather_id        Int?
  name              String?             @db.VarChar(100)
  main_category     String?             @db.VarChar(50)
  severity_level    Int?                @db.SmallInt
  record_timestamp  DateTime?           @default(now()) @db.Timestamp(6)
  fact_traffic_flow fact_traffic_flow[]
}

model fact_corridor_performance {
  corridor_perf_key     BigInt          @id
  corridor_key          BigInt
  time_key              Int
  date_key              Int
  bottleneck_seg_key    BigInt?
  timestamp             DateTime        @db.Timestamp(6)
  avg_corridor_speed    Decimal?        @db.Decimal(5, 2)
  total_delay_seconds   Int?
  travel_time_index     Decimal?        @db.Decimal(4, 2)
  corridor_efficiency   Decimal?        @db.Decimal(3, 2)
  active_incident_count Int?
  inserted_at           DateTime        @default(now()) @db.Timestamp(6)
  quality_flag          Int?            @default(1) @db.SmallInt
  corridor_version      Int             @default(1)
  dim_segment           dim_segment?    @relation(fields: [bottleneck_seg_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_corridor          dim_corridor    @relation(fields: [corridor_key], references: [corridor_key], onDelete: NoAction, onUpdate: NoAction)
  dim_date              dim_date        @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day       dim_time_of_day @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([inserted_at], map: "idx_fact_corridor_inserted_brin", type: Brin)
  @@index([bottleneck_seg_key], map: "idx_fact_corridor_perf_bottleneck")
  @@index([corridor_key], map: "idx_fact_corridor_perf_corridor")
  @@index([date_key], map: "idx_fact_corridor_perf_date")
  @@index([timestamp], map: "idx_fact_corridor_ts_brin", type: Brin)
  @@index([corridor_key, corridor_version], map: "idx_fact_corridor_perf_corridor_version")
}

model fact_event {
  event_id                                                   BigInt           @id
  start_time_key                                             Int?
  end_time_key                                               Int?
  date_key                                                   Int
  location_key                                               BigInt?
  event_type                                                 String?          @db.VarChar(50)
  attendance_scale                                           Int?
  impact_radius_m                                            Int?
  event_title                                                String?          @db.VarChar(255)
  inserted_at                                                DateTime         @default(now()) @db.Timestamp(6)
  quality_flag                                               Int?             @default(1) @db.SmallInt
  dim_date                                                   dim_date         @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day_fact_event_end_time_keyTodim_time_of_day   dim_time_of_day? @relation("fact_event_end_time_keyTodim_time_of_day", fields: [end_time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)
  dim_location                                               dim_location?    @relation(fields: [location_key], references: [location_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day_fact_event_start_time_keyTodim_time_of_day dim_time_of_day? @relation("fact_event_start_time_keyTodim_time_of_day", fields: [start_time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([date_key], map: "idx_fact_event_date")
  @@index([inserted_at], map: "idx_fact_event_inserted_brin", type: Brin)
  @@index([location_key], map: "idx_fact_event_location")
}

model fact_citizen_report {
  report_key                    BigInt                          @id @default(autoincrement())
  time_key                      Int
  date_key                      Int
  segment_key                   BigInt
  location_key                  BigInt?
  incident_type                 String                          @db.VarChar(50)
  description                   String?
  image_url                     String?
  timestamp                     DateTime                        @db.Timestamp(6)
  geometry                      Unsupported("geometry")
  reporter_id                   String                          @db.VarChar(255)
  status                        citizen_report_status           @default(PENDING)
  moderation_note               String?
  moderated_by                  String?                         @db.VarChar(255)
  approved_incident_key         BigInt?
  approved_at                   DateTime?                       @db.Timestamp(6)
  rejected_at                   DateTime?                       @db.Timestamp(6)
  created_at                    DateTime                        @default(now()) @db.Timestamp(6)
  updated_at                    DateTime                        @default(now()) @db.Timestamp(6)
  bridge_incident_confirmations bridge_incident_confirmations[]
  dim_date                      dim_date                        @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_location                  dim_location?                   @relation(fields: [location_key], references: [location_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment                   dim_segment                     @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day               dim_time_of_day                 @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_fact_citizen_report_status")
  @@index([reporter_id], map: "idx_fact_citizen_report_reporter")
  @@index([geometry], map: "idx_fact_citizen_report_geom_gist", type: Gist)
  @@index([approved_incident_key], map: "idx_fact_citizen_report_approved_incident")
  @@index([created_at(sort: Desc)], map: "idx_fact_citizen_report_created_at")
  @@index([segment_key, date_key], map: "idx_fact_citizen_report_segment_date")
  @@index([timestamp(sort: Desc)], map: "idx_fact_citizen_report_ts")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model fact_incident {
  incident_key    BigInt
  time_key        Int
  date_key        Int
  segment_key     BigInt
  location_key    BigInt?
  incident_type   String?                  @db.VarChar(50)
  timestamp       DateTime                 @db.Timestamp(6)
  severity_level  Int?                     @db.SmallInt
  delay_seconds   Int?
  geometry        Unsupported("geometry")?
  is_simulated    Boolean?                 @default(false)
  is_active       Boolean?                 @default(true)
  inserted_at     DateTime                 @default(now()) @db.Timestamp(6)
  quality_flag    Int?                     @default(1) @db.SmallInt
  dim_date        dim_date                 @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_location    dim_location?            @relation(fields: [location_key], references: [location_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment     dim_segment              @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day dim_time_of_day          @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@id([incident_key, date_key])
  @@index([date_key], map: "idx_fact_incident_date")
  @@index([geometry], map: "idx_fact_incident_geom_gist", type: Gist)
  @@index([inserted_at], map: "idx_fact_incident_inserted_brin", type: Brin)
  @@index([location_key], map: "idx_fact_incident_location")
  @@index([segment_key], map: "idx_fact_incident_segment")
  @@index([segment_key, date_key], map: "idx_fact_incident_segment_date")
  @@index([timestamp], map: "idx_fact_incident_ts_brin", type: Brin)
}

model fact_simulation_scenario {
  simulation_key  BigInt          @id
  time_key        Int
  date_key        Int
  segment_key     BigInt
  incident_key    BigInt?
  scenario_id     String?         @db.VarChar(50)
  timestamp       DateTime        @db.Timestamp(6)
  sim_avg_speed   Decimal?        @db.Decimal(5, 2)
  sim_travel_time Int?
  improvement_pct Decimal?        @db.Decimal(5, 2)
  is_optimal_plan Boolean?        @default(false)
  inserted_at     DateTime        @default(now()) @db.Timestamp(6)
  quality_flag    Int?            @default(1) @db.SmallInt
  dim_date        dim_date        @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment     dim_segment     @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day dim_time_of_day @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([date_key], map: "idx_fact_sim_date")
  @@index([inserted_at], map: "idx_fact_sim_inserted_brin", type: Brin)
  @@index([scenario_id], map: "idx_fact_sim_scenario_id")
  @@index([segment_key], map: "idx_fact_sim_segment")
  @@index([timestamp], map: "idx_fact_sim_ts_brin", type: Brin)
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model fact_traffic_flow {
  traffic_flow_key    BigInt
  segment_key         BigInt
  time_key            Int
  date_key            Int
  weather_key         Int?
  timestamp           DateTime        @db.Timestamp(6)
  pcu_volume          Decimal?        @db.Decimal(10, 2)
  traffic_index       Decimal?        @db.Decimal(3, 2)
  current_speed_kmh   Decimal?        @db.Decimal(5, 2)
  free_flow_speed_kmh Decimal?        @db.Decimal(5, 2)
  delay_seconds       Int?
  los_level           String?         @db.Char(1)
  congestion_level    Int?            @db.SmallInt
  is_closed           Boolean?        @default(false)
  inserted_at         DateTime        @default(now()) @db.Timestamp(6)
  quality_flag        Int?            @default(1) @db.SmallInt
  dim_date            dim_date        @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment         dim_segment     @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day     dim_time_of_day @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)
  dim_weather         dim_weather?    @relation(fields: [weather_key], references: [weather_key], onDelete: NoAction, onUpdate: NoAction)

  @@id([traffic_flow_key, date_key])
  @@index([date_key], map: "idx_fact_flow_date")
  @@index([segment_key], map: "idx_fact_flow_segment")
  @@index([segment_key, date_key], map: "idx_fact_flow_segment_date")
  @@index([time_key], map: "idx_fact_flow_time")
  @@index([weather_key], map: "idx_fact_flow_weather")
  @@index([inserted_at], map: "idx_fact_traffic_flow_inserted_brin", type: Brin)
  @@index([timestamp], map: "idx_fact_traffic_flow_ts_brin", type: Brin)
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model fact_traffic_risk_prediction {
  prediction_key       BigInt
  segment_key          BigInt
  time_key             Int
  date_key             Int
  timestamp            DateTime        @db.Timestamp(6)
  horizon_minutes      Int?
  predicted_risk_score Decimal?        @db.Decimal(3, 2)
  confidence_level     Decimal?        @db.Decimal(3, 2)
  model_version        String?         @db.VarChar(20)
  inserted_at          DateTime        @default(now()) @db.Timestamp(6)
  quality_flag         Int?            @default(1) @db.SmallInt
  dim_date             dim_date        @relation(fields: [date_key], references: [date_key], onDelete: NoAction, onUpdate: NoAction)
  dim_segment          dim_segment     @relation(fields: [segment_key], references: [segment_key], onDelete: NoAction, onUpdate: NoAction)
  dim_time_of_day      dim_time_of_day @relation(fields: [time_key], references: [time_key], onDelete: NoAction, onUpdate: NoAction)

  @@id([prediction_key, date_key])
  @@index([date_key], map: "idx_fact_risk_pred_date")
  @@index([inserted_at], map: "idx_fact_risk_pred_inserted_brin", type: Brin)
  @@index([segment_key], map: "idx_fact_risk_pred_segment")
  @@index([segment_key, date_key], map: "idx_fact_risk_pred_segment_date")
  @@index([timestamp], map: "idx_fact_risk_pred_ts_brin", type: Brin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model dim_user {
  user_id                       String                          @id @db.VarChar(255)
  clerk_id                      String?                         @unique @db.VarChar(255)
  reputation_score              Int?                            @default(0)
  trust_weight                  Float?                          @default(1.0)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  bridge_incident_confirmations bridge_incident_confirmations[]
}

model bridge_incident_confirmations {
  id                  BigInt              @id @default(autoincrement())
  report_key          BigInt
  user_id             String              @db.VarChar(255)
  is_true             Boolean
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  fact_citizen_report fact_citizen_report @relation(fields: [report_key], references: [report_key], onDelete: NoAction, onUpdate: NoAction, map: "fk_confirmation_report")
  dim_user            dim_user            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_confirmation_user")

  @@unique([report_key, user_id], map: "uq_incident_confirm_report_user")
}

model fact_forecast_segment_mart {
  segment_key        BigInt
  corridor_key       BigInt?
  date_key           Int
  time_key           Int
  timestamp          DateTime @db.Timestamp(6)
  current_speed_kmh  Float?
  pcu_volume         Float?
  traffic_index      Float?
  delay_seconds      Float?
  quality_flag       Int?
  target_label       Int?
  default_lane_count Int?
  static_free_flow   Float?
  osm_highway_type   String?
  district           String?
  day_of_week        String?
  shift_code         String?
  weather_severity   Int?
  time_sin           Float?
  time_cos           Float?
  inserted_at        DateTime @default(now()) @db.Timestamp(6)

  @@id([segment_key, date_key, time_key])
  @@index([corridor_key, timestamp(sort: Desc)], map: "idx_ffsm_corridor_ts")
  @@index([segment_key, timestamp(sort: Desc)], map: "idx_ffsm_segment_ts")
}

enum citizen_report_status {
  PENDING
  APPROVED
  REJECTED
}

enum IncidentSource {
  SENSOR
  ADMIN
  USER_REPORT
}

enum IncidentStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}
