# ════════════════════════════════════════════════════════════════════════════════
# AI-CORE ENVIRONMENT CONFIGURATION
# 
# Sao chép file này thành .env và chỉnh sửa các giá trị thực tế
# cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════════════════
# DATABASE (Kết nối tới PostgreSQL Data Warehouse)
# ════════════════════════════════════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=traffic_ioc_db
DB_SCHEMA=public
# Nếu chạy trong Docker Compose, sử dụng service name:
# DB_HOST=postgres

# ════════════════════════════════════════════════════════════════════════════════
# API SERVICE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ════════════════════════════════════════════════════════════════════════════════
# MODEL PATHS (Đường dẫn tới pre-trained models)
# ════════════════════════════════════════════════════════════════════════════════
MODEL_PATH=./models
FORECAST_MODEL_PATH=./models/traffic_forecast/lstm_model.pkl
RL_CONGESTION_MODEL_PATH=./models/congestion_rl/dqn_agent.pt
CLUSTERING_MODEL_PATH=./models/clustering/kmeans_model.pkl
SCALER_PATH=./models/clustering/scaler.pkl

# ════════════════════════════════════════════════════════════════════════════════
# FORECAST CONFIG (Cấu hình dự báo tốc độ)
# ════════════════════════════════════════════════════════════════════════════════
# Số phút để dự báo (ví dụ: 15 phút)
FORECAST_HORIZON=15

# Số phút dữ liệu lịch sử dùng làm input (480 phút = 8 giờ)
FORECAST_HISTORY_WINDOW=480

# Sử dụng Ensemble (LSTM + Random Forest) hay single model?
FORECAST_ENSEMBLE_ENABLED=true

# ════════════════════════════════════════════════════════════════════════════════
# REINFORCEMENT LEARNING CONFIG (Cấu hình dự báo tắc nghẽn RL)
# ════════════════════════════════════════════════════════════════════════════════
# Thuật toán RL: 'dqn' hoặc 'ppo'
RL_ALGORITHM=dqn

# Ngưỡng Traffic Index để xác định tắc nghẽn
# (TI >= 0.6 = congested, TI < 0.6 = free)
RL_CONGESTION_THRESHOLD=0.6

# Số phút dữ liệu lịch sử cho RL input (180 phút = 3 giờ)
RL_HISTORY_WINDOW=180

# Dự báo tắc nghẽn sau N phút nữa (15 phút)
RL_PREDICTION_HORIZON=15

# Exploration rate (epsilon-greedy policy)
RL_EPSILON=0.1

# ════════════════════════════════════════════════════════════════════════════════
# CLUSTERING & IMPUTATION CONFIG (Cấu hình gom cụm & imputation dữ liệu)
# ════════════════════════════════════════════════════════════════════════════════
# Thuật toán clustering: 'kmeans' hoặc 'dbscan'
CLUSTERING_ALGORITHM=kmeans

# Số cluster cho K-Means (thường 8-10)
CLUSTERING_N_CLUSTERS=8

# Epsilon cho DBSCAN (nếu sử dụng DBSCAN)
CLUSTERING_DBSCAN_EPS=0.5

# Minimum samples cho DBSCAN
CLUSTERING_DBSCAN_MIN_SAMPLES=5

# Features dùng cho clustering (comma-separated)
# Ví dụ: geometry,avg_speed,peak_hour_ratio,lane_count
CLUSTERING_FEATURES=geometry,avg_speed,peak_hour_ratio

# Phương pháp imputation: 'knn', 'cluster_mean', hoặc 'weighted_average'
IMPUTATION_METHOD=knn

# Số neighbors cho KNN imputation
IMPUTATION_K_NEIGHBORS=5

# ════════════════════════════════════════════════════════════════════════════════
# OPTIONAL: REDIS CACHE (Nếu sử dụng caching)
# ════════════════════════════════════════════════════════════════════════════════
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ════════════════════════════════════════════════════════════════════════════════
# OPTIONAL: TESTING & DEVELOPMENT
# ════════════════════════════════════════════════════════════════════════════════
# Chế độ debug
DEBUG=false

# Environment: 'development', 'staging', 'production'
ENVIRONMENT=development
